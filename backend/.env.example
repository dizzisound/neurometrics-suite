/**
 * Questo file serve come esempio e non deve essere utilizzato direttamente in produzione.
 * Copiare il contenuto in un file `.env` e sostituire i valori segnaposto con quelli reali.
 * Non contiene valori reali, solo segnaposto.
 * Non deve essere incluso nel controllo versione.
 *
 */

# Configurazione di Rete
PORT=3000
NODE_ENV=development

# Configurazione Database (Dati Sanitari Anonimizzati)
MONGODB_USERNAME="<your_mongodb_username>"
MONGODB_PASSWORD="<your_mongodb_password>"
MONGODB_URI="mongodb://[host]:[port]/[database_name]"
MONGO_DB_NAME="<your_mongodb_database_name>"
# Local MongoDB connection (uncomment if using local MongoDB)
# MONGODB_URI=mongodb://localhost:27017/<your_mongodb_database_name>

# Sicurezza e Crittografia (JWT e Salt)
# NOTA: In produzione usa una stringa alfanumerica complessa generata casualmente
JWT_SECRET="<your_jwt_secret>"
BCRYPT_SALT_ROUNDS=12

# Configurazione Esportazione Statistica
DEFAULT_CSV_DELIMITER=;