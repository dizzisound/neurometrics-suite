# Variabili usate da docker-compose.yml per il servizio neuro-backend.
# Docker Compose carica automaticamente un file `.env` posizionato accanto a
# docker-compose.yml (questa cartella) — copiare questo file in `.env` e
# compilare i valori reali. Non è lo stesso file di backend/.env, che serve
# solo per l'esecuzione locale (npm run dev) fuori da Docker.

# Richiesto da env.config.ts (Zod) — deve essere lungo almeno 32 caratteri
JWT_SECRET="<stringa_alfanumerica_lunga_e_casuale>"

BCRYPT_SALT_ROUNDS=12

# Richieste da env.config.ts (Zod) ma non usate per la connessione: il
# container mongo:6.0 in docker-compose.yml non ha l'autenticazione abilitata,
# quindi qualsiasi valore non vuoto soddisfa la validazione.
MONGODB_USERNAME="<placeholder_non_usato_per_lautenticazione>"
MONGODB_PASSWORD="<placeholder_non_usato_per_lautenticazione>"
